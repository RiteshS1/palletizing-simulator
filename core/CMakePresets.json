{
  "version": 6,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": { "VCPKG_MANIFEST_FEATURES": "tools" }
    },
    {
      "name": "release",
      "displayName": "Release (apps, tests, benchmarks)",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "debug-asan",
      "displayName": "Debug + AddressSanitizer + UndefinedBehaviorSanitizer",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer -fno-sanitize-recover=all",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined",
        "PAL_BUILD_BENCHMARKS": "OFF"
      }
    },
    {
      "name": "wasm",
      "displayName": "WebAssembly (Emscripten) for the web app",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "VCPKG_TARGET_TRIPLET": "wasm32-emscripten",
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "$env{EMSCRIPTEN_ROOT}/cmake/Modules/Platform/Emscripten.cmake",
        "VCPKG_MANIFEST_FEATURES": "",
        "PAL_BUILD_TESTS": "OFF",
        "PAL_BUILD_APPS": "OFF",
        "PAL_BUILD_BENCHMARKS": "OFF"
      }
    }
  ],
  "buildPresets": [
    { "name": "release", "configurePreset": "release" },
    { "name": "debug-asan", "configurePreset": "debug-asan" },
    { "name": "wasm", "configurePreset": "wasm" }
  ],
  "testPresets": [
    { "name": "release", "configurePreset": "release", "output": { "outputOnFailure": true }, "execution": { "jobs": 8 } },
    { "name": "debug-asan", "configurePreset": "debug-asan", "output": { "outputOnFailure": true }, "execution": { "jobs": 8 } }
  ]
}
